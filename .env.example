# Copie para .env (Docker Compose). Valores reais nunca vão para o repositório.

# PostgreSQL. Use uma senha longa e SEM caracteres especiais de URL (@ : / ? # %).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=karolglow

# Docker Compose local/homologação (em produção as variáveis vão no manager.yaml)
APP_PORT=3008
# Endereço público do site (com https:// em produção)
CORS_ORIGINS=http://localhost:3008
