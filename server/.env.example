# Copie para server/.env e ajuste. Este arquivo é o único .env versionado: nunca coloque valores reais aqui.

NODE_ENV=development
PORT=3001

# Conexão com o PostgreSQL
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/karolglow
DB_SSL=false
DB_POOL_MAX=10

# Origens do site autorizadas a chamar a API (separe por vírgula)
CORS_ORIGINS=http://localhost:5173

# Em produção atrás de proxy/load balancer, informe quantos proxies existem (para o IP real)
TRUST_PROXY=0

# Sessão do admin
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30

# Bloqueio de login
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
